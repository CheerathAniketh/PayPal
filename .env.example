# Copy this file to .env and fill in your own values. Never commit .env.

# PayPal (sandbox only). Create a REST app at developer.paypal.com using a
# US-region Business sandbox account (an India-region merchant failed USD
# checkout with UNSUPPORTED_PAYEE_CURRENCY in our testing).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Webhook ID of the webhook registered on that app, pointing at <your-url>/webhook
# for CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED.
# Needed by the API server to verify incoming events. Not needed for the batch demo.
# Without it, /webhook returns 503.
PAYPAL_WEBHOOK_ID=

# Protects POST /api/demo/order. Any long random string.
# If unset, that endpoint returns 404.
DEMO_TOKEN=

# Optional: Gemini narration (also run: pip install -r requirements-narrator.txt)
GEMINI_API_KEY=
# RECOUP_NARRATOR=gemini
# GEMINI_MODEL=gemini-3.5-flash-lite
# RECOUP_NARRATE_OUTREACH=1